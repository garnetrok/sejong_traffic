# 로컬 실행용: 이 파일을 .env 로 복사한 뒤 실제 값을 넣으세요. (.env 는 깃헙에 올라가지 않습니다)
# Render 에서는 같은 이름으로 Environment 에 넣으면 됩니다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<supabase service_role key>

# 국가교통정보센터 OpenAPI 키 (서비스별 월 100건 한도)
ITS_API_KEY=<its api key>
# 일일 자동 수집(/collect) 보호용 임의 문자열. GitHub Secrets 에도 같은 값
COLLECT_TOKEN=<random string>

# 선택
# DASHBOARD_PASSWORD=<접속 비밀번호 — 설정하면 대시보드 접속 시 물어봄>
# GEMINI_API_KEY=<Google AI Studio key>
